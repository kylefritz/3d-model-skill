// Cloudflare Workers: the same site/ folder GitHub Pages serves, plus a small script for the
// viewer's comments (/api/*, in a free D1 database). Details in docs/publish.md and docs/comments.md.
//   make build && npx wrangler@4 deploy
// First deploy lands on <name>.<your-subdomain>.workers.dev. For your own domain, the
// zone has to be on Cloudflare; uncomment routes and redeploy (Cloudflare makes the DNS
// record and the certificate). No account_id here: wrangler asks, or reads
// CLOUDFLARE_ACCOUNT_ID from the environment.
//
// Comments: `npx wrangler@4 d1 create 3d-model-comments`, paste its database_id below, then
// `make deploy-cloudflare` (it applies the migrations first). To publish without comments,
// delete the d1_databases block: the viewer hides its Comment button when /api/ isn't there.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "3d-model-skill",
  // wrangler dev runs a bundled workerd that may not know a very new date; keep this one it supports.
  "compatibility_date": "2026-10-30",
  "main": "worker/index.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "3d-model-comments",
      "database_id": "<your-database-id>",
      "migrations_dir": "worker/migrations"
    }
  ]
  // "routes": [{ "pattern": "house.example.com", "custom_domain": true }]
}
